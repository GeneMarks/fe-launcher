datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Client {
  id          String    @id @default(uuid())
  machineName String    @unique
  ipAddress   String?
  connected   Boolean   @default(false)
  lastSeen    DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status      SessionStatus @default(PENDING)
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  processes   Process[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Process {
  id                   String              @id @default(uuid())
  sessionId            String
  session              Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  phase                ProcessPhase
  type                 ProcessType         @default(EXECUTABLE)
  target               String?             // Executable path
  arguments            String?             // Optional CLI arguments for executable
  scriptContent        String?             // Lua script code
  delayMs              Int                 @default(0)
  order                Int
  status               ProcessStatus       @default(PENDING)
  exitCode             Int?
  exitBehavior         ProcessExitBehavior @default(NONE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([sessionId, order])
}

enum SessionStatus {
  PENDING
  STARTED
  RUNNING_PRE_PROCESSES
  RUNNING_FRONTEND
  RUNNING_POST_PROCESSES
  COMPLETED
  ABORTED
  FAILED
}

enum ProcessPhase {
  PRE
  MAIN
  POST
}

enum ProcessType {
  EXECUTABLE
  LUA_SCRIPT
}

enum ProcessStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProcessExitBehavior {
  NONE,
  END_SESSION,
  RESTART_SESSION,
  RESTART_SELF
}